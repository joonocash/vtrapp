# Production Environment Variables
# Copy this file to .env and fill in your actual values

# Trafiklab API Key
TRAFIKLAB_API_KEY=your_api_key_here

# OpenRouteService API Key (Cassie-fliken, lastbilsrutter via driving-hgv)
ORS_API_KEY=your_ors_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS Configuration (your Tailscale domain or IP)
# Example: http://100.x.y.z:3000 or https://your-tailscale-hostname
FRONTEND_URL=http://localhost:3000

# WoW-fliken (valfritt). Token och port läses annars från ~/wow-assistent/.env.
# WOW_ENV_FILE=/home/joono/wow-assistent/.env
# WOW_API_URL=http://127.0.0.1:8080
# WOW_API_TOKEN=
