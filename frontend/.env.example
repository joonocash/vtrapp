# Google Maps JavaScript API-nyckel. Måste ligga i frontend eftersom kartan
# renderas i webbläsaren — skydda den i stället med en HTTP-referrer-
# restriktion i Cloud Console (Credentials -> din nyckel -> Application
# restrictions -> Websites).
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Map ID för en vektorkarta (Cloud Console -> Map Management -> Map ID med
# renderingstyp "Vector"). Krävs för WebGLOverlayView och map.moveCamera() —
# fungerar inte på en rasterkarta.
VITE_GOOGLE_MAPS_MAP_ID=your_vector_map_id_here
